# Copy to .env for Docker Compose. Never commit real secrets.
AUTH__SIGNINGKEY=replace-with-at-least-32-random-characters
AUTH__SESSIONHOURS=8
OPENAI_API_KEY=
OPENAI_ENABLED=true
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses
FRONTENDURL=http://localhost:4200
CONNECTIONSTRINGS__DEFAULT=Data Source=data/itsupport.db
UPLOADS__MAXFILESIZEBYTES=10000000
UPLOADS__PATH=uploads
LIVECHAT__ENABLED=true
LIVECHAT__INACTIVITYMINUTES=30
CHATBOT__ENABLED=true
CHATBOT__USEKNOWLEDGEBASE=true
CHATBOT__REQUIRETICKETCONFIRMATION=true
CHATBOT__LIVEAGENTESCALATION=true
